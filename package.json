{
  "name": "@phantasy/plugin-monitoring",
  "version": "2.0.1",
  "private": false,
  "description": "Installable monitoring plugin surface for Phantasy",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "admin-ui-dist",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "phantasy.plugin.json"
  ],
  "sideEffects": false,
  "keywords": [
    "metrics",
    "monitoring"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/phantasy-bot/plugin-monitoring"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/phantasy-bot/plugin-monitoring",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@phantasy/agent": "^2.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.9.2"
  },
  "phantasy": {
    "displayName": "Monitoring",
    "category": "observability",
    "tags": [
      "metrics",
      "monitoring"
    ],
    "workspace": "operations",
    "extensionKind": "capability",
    "permissions": [],
    "platforms": [
      "node"
    ],
    "productionReady": true,
    "adminSurface": {
      "tabId": "monitoring",
      "label": "Monitoring",
      "section": "operations",
      "workspace": "operations",
      "kind": "native",
      "entry": "/admin-ui/index.js",
      "assetRoot": "admin-ui-dist",
      "keywords": [
        "logs",
        "metrics",
        "analytics",
        "stats"
      ],
      "dashboardIcon": "analyticsTile2",
      "dashboardPromoted": false
    },
    "configSchema": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        }
      }
    }
  }
}
